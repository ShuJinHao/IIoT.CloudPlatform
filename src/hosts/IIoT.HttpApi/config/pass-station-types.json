{
  "PassStationTypes": {
    "types": [
      {
        "typeKey": "die-cutting-completion",
        "legacyTypeKeys": [
          "ap",
          "cp"
        ],
        "displayName": "模切完成记录",
        "description": "当前 AP/CP 插件共用的模切完成记录公共 Schema。AP/CP 仅为历史兼容 TypeKey，不代表工序、插件或设备。",
        "supportedModes": [
          "barcode-process",
          "time-process",
          "device-barcode",
          "device-time",
          "device-latest"
        ],
        "fields": [
          {
            "key": "plcCode",
            "label": "PLC 编码",
            "type": "string",
            "required": true,
            "maxLength": 64
          },
          {
            "key": "plcName",
            "label": "PLC 名称",
            "type": "string",
            "required": true,
            "maxLength": 128
          },
          {
            "key": "clipSlot",
            "label": "弹夹位",
            "type": "enum",
            "required": true,
            "options": [
              "MG1",
              "MG2"
            ]
          },
          {
            "key": "startTime",
            "label": "开始时间",
            "type": "datetime",
            "required": true
          },
          {
            "key": "punchingQuantity",
            "label": "冲切数量",
            "type": "integer",
            "required": true,
            "min": 0
          },
          {
            "key": "punchingSpeed",
            "label": "冲切速度",
            "type": "number",
            "required": true,
            "min": 0,
            "precision": 5
          }
        ],
        "listColumns": [
          "plcName",
          "clipSlot",
          "barcode",
          "cellResult",
          "punchingQuantity",
          "punchingSpeed",
          "completedTime"
        ],
        "detailSections": [
          {
            "title": "基础信息",
            "fields": [
              "barcode",
              "deviceId",
              "cellResult",
              "completedTime",
              "receivedAt"
            ]
          },
          {
            "title": "模切完成数据",
            "fields": [
              "plcCode",
              "plcName",
              "clipSlot",
              "startTime",
              "punchingQuantity",
              "punchingSpeed"
            ]
          }
        ]
      }
    ]
  }
}
